// Pulse — coordination store only. Nothing here is durable user data:
// rows are deleted on leave, on staleness, or after a signal is delivered.
// Chat text and video are NOT modeled — they ride WebRTC peer-to-peer and
// never reach the server.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum PresenceStatus {
  available
  busy
  on_call
  searching
  pending_accept
}

model Presence {
  id         String         @id // client-generated session uuid (public on the map)
  secretHash String // SHA-256 of tab-only session secret (never sent in poll peers)
  lat        Float // ALREADY privacy-offset coords (raw is never stored)
  lng        Float
  status     PresenceStatus @default(available)
  peerId     String? // active connection partner (never sent in poll peers)
  lastSeen   DateTime

  // Session-only preferences (deleted with the row)
  spokenLanguages   String? // JSON array of language codes
  preferredLanguage String?
  gender            String? // man | woman | unspecified

  // Random match queue (never exposed on map peers)
  matchLanguage      String?
  matchGenderPref    String? // anyone | men | women
  matchMode          String? // text | text_video — agreed mode for this pair
  matchId            String?
  matchPartnerId     String?
  matchExpiresAt     DateTime?
  matchAccepted      Boolean   @default(false)
  matchCooldownUntil DateTime?

  @@index([lastSeen])
  @@index([peerId])
  @@index([matchId])
  @@index([status])
}

model Signal {
  // Mailbox for connection requests + WebRTC signaling only.
  id        String   @id @default(uuid())
  toId      String // recipient session id
  fromId    String // sender session id
  type      String // request | accept | decline | offer | answer | ice | end
  payload   String? // JSON string (SDP / ICE candidate)
  createdAt DateTime @default(now())

  @@index([toId])
}
